# apps/ai — copy to .env and fill DATABASE_URL + AI_SERVICE_TOKEN.
# These are the NATIVE-dev endpoints (localhost). The `full` Docker profile
# overrides RABBITMQ_URL / S3_ENDPOINT to in-network hostnames automatically.

# Shared Neon Postgres (same as apps/web DATABASE_URL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require

# RabbitMQ (docker compose)
RABBITMQ_URL=amqp://guest:guest@localhost:5672//

# MinIO / S3 (docker compose)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=knowledgeos
S3_REGION=us-east-1

# Shared bearer token Next uses to call this service (generate a random one)
AI_SERVICE_TOKEN=change-me

# WHISPER_MODEL=base   # phase 2d
