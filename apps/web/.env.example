# Copy to .env.local and fill in. .env.local is git-ignored.

# --- Database (Neon Postgres, pooled connection string) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&channel_binding=require"

# --- Redis (self-hosted; rate limiting + ephemeral security state) ---
REDIS_URL="redis://127.0.0.1:6379"

# --- Security ---
# HMAC key to hash session/one-time tokens before storage. Generate: openssl rand -hex 32
TOKEN_HASHING_KEY=""

# App origin (used in email links and Origin/CSRF checks)
APP_URL="http://localhost:3000"

# --- Email (SMTP via nodemailer) ---
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"          # true for port 465, false for 587 (STARTTLS)
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="KnowledgeOS <no-reply@example.com>"

# --- Object storage (MinIO / S3-compatible) ---
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="knowledgeos"
S3_REGION="us-east-1"

# --- Media / AI service (apps/ai) ---
AI_SERVICE_URL="http://localhost:8001"
AI_SERVICE_TOKEN=""   # must match apps/ai/.env

# --- LLM helpers (optional; AI course-outline + quiz generation) ---
# Leave AI_PROVIDER unset to disable AI helpers (buttons hide). Pick ONE provider.
# Recommended free option: Gemini (stable free tier, good JSON output).
# AI_PROVIDER="gemini"        # or "openrouter"
# Google Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
# OpenRouter (one key): free catalog rotates — pick a current ":free" slug from
# https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3.5-lightning:free"

# --- Reminders cron (optional) ---
# Shared secret for GET/POST /api/cron/reminders (due-soon/overdue emails).
# Generate: openssl rand -hex 32 . Leave empty to disable the endpoint.
CRON_SECRET=""

# --- Seed admin (used by `bun run db:seed`) ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
SEED_ADMIN_NAME="Admin"

CRON_SECRET=$(openssl rand -hex 32)   # any long random string

